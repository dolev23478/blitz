# Pre-production environment configuration for blitz
PORT=3000

# AWS S3 Integration (Pre-production)
# Authenticated via Kubernetes IAM Roles for Service Accounts (IRSA):
# ServiceAccount: s3-uploader-sa (ARN: arn:aws:iam::783197655513:role/k8s-s3-data-forge-role)
# Static credentials (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY) are NOT required.
AWS_REGION=il-central-1
S3_REGION=il-central-1
S3_BUCKET=data-forge-pre
S3_PUBLIC_BASE_URL=https://data-forge-pre.s3.il-central-1.amazonaws.com
S3_KEY_PREFIX=media
MEDIA_MAX_MB=50

# Core cluster services (fill with cluster endpoints)
# REDIS_URL=
# KAFKA_BROKERS=
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION_STRING=
# TG_TARGETS=
