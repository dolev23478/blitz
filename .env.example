# Local development: copy this file to .env and fill in real values.
# Production/web: set the same names in your hosting provider's environment settings.

# Core app config
REDIS_URL=
POLL_SECONDS=30
BACKFILL_DAYS=7
REQUEST_DELAY_MS=1000
CONCURRENCY=3
API_KEY=
CORS_ORIGIN=

# Telegram / MTProto
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_WATCHDOG_SECONDS=30
TG_SYNC_SECONDS=300
TG_TARGETS=
SCAN_DELAY_MIN_MS=1500
SCAN_DELAY_MAX_MS=3000

# Kafka / transformer
KAFKA_BROKERS=
KAFKA_CLIENT_ID=blitz-transformer
# Fixed delay after a failed publication. Queue is in memory and does not survive restart.
KAFKA_RETRY_INTERVAL_MS=60000
KAFKA_SSL=false
# Optional SASL: plain, scram-sha-256, scram-sha-512
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Optional trusted DE schema file. Without it, validation is explicitly provisional.
# DE_RAW_REPORT_SCHEMA_PATH=

# X scraper provider
SCRAPER_PROVIDER=
OUTPUT_DIR=
HTTP_TIMEOUT_MS=
DICTIONARIES_DIR=

# TwitterAPI.io
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=

# Apify
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo~tweet-scraper

# Example production values:
# DATABASE_URL=postgres://user:pass@db-host:5432/telegram
# REDIS_URL=redis://:password@redis-host:6379
# KAFKA_BROKERS=kafka-1:9092,kafka-2:9092
# API_KEY=super-secret-key
# TG_API_ID=12345678
# TG_API_HASH=abcd1234efgh5678
# TG_SESSION_STRING=...
# TG_TARGETS=@mychannel,-1001234567890
