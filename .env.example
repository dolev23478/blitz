# Transformer: another Nest service passes already unique collector data directly.
# Native Kafka bootstrap addresses (host:port), separated by commas. No HTTP URL.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=blitz-transformer
KAFKA_SSL=false
# Optional SASL: plain, scram-sha-256, scram-sha-512
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Optional trusted DE schema file. Without it, validation is explicitly provisional.
# DE_RAW_REPORT_SCHEMA_PATH=
