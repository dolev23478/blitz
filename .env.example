# No Redis. Another Nest service calls TransformerWorkflow.run(input).
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=blitz-transformer
KAFKA_SSL=false
# Optional SASL: plain, scram-sha-256, scram-sha-512
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# MVP dedup is local to this process and resets on restart.
DEDUP_TTL_MS=86400000
DEDUP_MAX_ENTRIES=10000

# Optional trusted DE schema file. Without it, validation is explicitly provisional.
# DE_RAW_REPORT_SCHEMA_PATH=
