# Local development: copy this file to .env and fill in real values.
# Production/web: set the same names in your hosting provider's environment settings.

# Core app config
PORT=3000
# Required for durable Transformer publication retries and collector resume timestamps.
REDIS_URL=
API_KEY=
CORS_ORIGIN=*

# Telegram / MTProto
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_WATCHDOG_SECONDS=30
TG_SYNC_SECONDS=300
TG_TARGETS=
SCAN_DELAY_MIN_MS=1500
SCAN_DELAY_MAX_MS=3000

# Kafka / transformer
KAFKA_BROKERS=
KAFKA_CLIENT_ID=blitz-transformer
# Fixed retry delay. Reports are persisted in Redis; initial attempt plus 3 retries.
# Exhausted reports are discarded permanently by the user's explicit policy.
KAFKA_RETRY_INTERVAL_MS=60000
TRANSFORMER_RETRY_PREFIX=blitz:{reports.raw}:outbox
KAFKA_SSL=false
# Optional SASL: plain, scram-sha-256, scram-sha-512
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Optional remote Kafka: every report is also mirrored here (best effort; never blocks the local Kafka above).
# Uses SASL_SSL. Address/password: see connecting-from-code-tutorial.md (user kafka-client).
# KAFKA_REMOTE_BROKERS=kafka-kafka-bootstrap.data-ai-prep.svc:9093
# KAFKA_REMOTE_TOPIC=reports.raw
# KAFKA_REMOTE_SASL_MECHANISM=scram-sha-512
# KAFKA_REMOTE_SASL_USERNAME=kafka-client
# KAFKA_REMOTE_SASL_PASSWORD=
# KAFKA_REMOTE_SSL_CA_FILE=./ca.crt
# Optional trusted DE schema file. Without it, validation is explicitly provisional.
# DE_RAW_REPORT_SCHEMA_PATH=

# Radio starts with the application. Set false to disable local collection.
RADIO_ENABLED=true
RADIO_DATA_DIR=.radio
RADIO_MODEL=tiny
RADIO_CPU_THREADS=2
RADIO_JOB_TIMEOUT_SECONDS=900
# The Whisper model is downloaded from Hugging Face on the first radio job and cached in RADIO_DATA_DIR/models.
# Default Python: .venv-radio/Scripts/python.exe on Windows; .venv-radio/bin/python elsewhere.
# RADIO_PYTHON_PATH=.venv-radio/Scripts/python.exe
# Recording/pause durations and stations are configured in src/radio/radio.constants.ts.
# The full app filters radio transcripts with analyzeText(auto), then forwards accepted reports to Kafka.
# No audio/transcript files are saved; accepted transcripts are logged.
# report_url uses the station stream URL with #clip=<UUID>.
# radio:once and radio:demo remain local diagnostics without publishing.
# radio:start runs the full radio/filter/Transformer/Kafka path without starting Telegram or X.

# X scraper provider
SCRAPER_PROVIDER=twitterapi_io
OUTPUT_DIR=./output
HTTP_TIMEOUT_MS=30000
DICTIONARIES_DIR=

# TwitterAPI.io
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# Apify
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo~tweet-scraper

# Example production values:
# REDIS_URL=redis://:password@redis-host:6379
# KAFKA_BROKERS=kafka-1:9092,kafka-2:9092
# API_KEY=super-secret-key
# TG_API_ID=12345678
# TG_API_HASH=abcd1234efgh5678
# TG_SESSION_STRING=...
# TG_TARGETS=@mychannel,-1001234567890
