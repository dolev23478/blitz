# Run ONLY on a connected preparation machine, before committing vendor assets.
FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ca-certificates libgomp1 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY requirements-radio.txt ./
RUN python3 -m venv /app/.venv-radio \
  && /app/.venv-radio/bin/python -m pip install --no-cache-dir -r requirements-radio.txt
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NEXT_TELEMETRY_DISABLED=1
